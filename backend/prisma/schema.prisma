/// A manager's conversation with the assistant that operates the system for them.
model ManagerChat {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  /// Taken from the first message the manager writes.
  title          String?              @db.VarChar(80)
  /// How many of the chat's latest messages the assistant reads (2 to 30; a CHECK in the database holds the range). Older ones stay on screen but are not used.
  contextMessages Int                 @default(6) @map("context_messages")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages       ManagerChatMessage[]
  confirmations  ManagerChatConfirmation[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_manager_chats_user")
  @@map("manager_chats")
}

/// One turn of a manager chat: what the manager said, what the assistant said, or a tool the assistant used (name, a summary of its input, how it ended).
model ManagerChatMessage {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId           String      @map("chat_id") @db.Uuid
  role             String      @db.VarChar(20)
  content          String      @default("")
  toolName         String?     @map("tool_name") @db.VarChar(80)
  toolInputSummary String?     @map("tool_input_summary")
  toolOutcome      String?     @map("tool_outcome") @db.VarChar(30)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  chat             ManagerChat @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chatId, createdAt], map: "idx_manager_chat_messages_chat")
  @@map("manager_chat_messages")
}

/// A destructive action the assistant asked to run. It runs only when the manager confirms in the dashboard with the one-time token (stored hashed) within five minutes.
model ManagerChatConfirmation {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId     String      @map("chat_id") @db.Uuid
  tokenHash  String      @unique @map("token_hash") @db.VarChar(64)
  actionName String      @map("action_name") @db.VarChar(80)
  input      Json
  summary    String
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?   @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  chat       ManagerChat @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chatId], map: "idx_manager_chat_confirmations_chat")
  @@map("manager_chat_confirmations")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiInstruction {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(80)
  content        String
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, key])
  @@map("ai_instructions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiInterpretation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId        String   @unique @map("message_id") @db.Uuid
  modelName        String   @map("model_name") @db.VarChar(120)
  promptVersion    String   @map("prompt_version") @db.VarChar(40)
  primaryIntent    String   @map("primary_intent") @db.VarChar(60)
  structuredOutput Json     @map("structured_output")
  confidenceScore  Decimal? @map("confidence_score") @db.Decimal(5, 4)
  processingStatus String   @default("PENDING") @map("processing_status") @db.VarChar(30)
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message          Message  @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ai_interpretations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Attachment {
  id                            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId                     String?              @map("message_id") @db.Uuid
  attachmentType                String               @map("attachment_type") @db.VarChar(30)
  storageKey                    String               @map("storage_key")
  originalFilename              String?              @map("original_filename") @db.VarChar(255)
  mimeType                      String               @map("mime_type") @db.VarChar(120)
  fileSizeBytes                 BigInt?              @map("file_size_bytes")
  checksumSha256                String?              @map("checksum_sha256") @db.VarChar(64)
  transcriptionText             String?              @map("transcription_text")
  createdAt                     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  r2Key                         String?              @map("r2_key")
  publicUrl                     String?              @map("public_url")
  vision                        Json?
  organizationId                String?              @map("organization_id") @db.Uuid
  organization                  Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evidence                      Evidence[]
  message                       Message?             @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  incidentAttachments           IncidentAttachment[]
  jobsByDeliveryProofAttachment Job[]                @relation("jobs_delivery_proof_attachment_idToattachments")
  jobsByPickupProofAttachment   Job[]                @relation("jobs_pickup_proof_attachment_idToattachments")

  @@map("attachments")
}


# --- Required. The app refuses to start without these (see src/platform/config.js) ---
# Add these parameters: ?connection_limit=10&pool_timeout=10&connect_timeout=5
# In production it must also contain sslmode=require&sslaccept=strict (the app refuses to start otherwise).
DATABASE_URL=<DATABASE_URL>
# Bounded transaction budgets for multi-query operations against a remote database.
DB_TRANSACTION_TIMEOUT_MS=30000
DB_TRANSACTION_MAX_WAIT_MS=10000
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<SESSION_SECRET>

# --- Server (optional) ---
PORT=4000
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS. Empty = same-origin only.
CORS_ORIGINS=

# --- Logging to Axiom (required when NODE_ENV=production) ---
AXIOM_API_KEY=<AXIOM_API_KEY>
AXIOM_DATASET=<AXIOM_DATASET>

WHATSAPP_VERIFY_TOKEN=<WHATSAPP_VERIFY_TOKEN>
# Wait for a pause between text fragments before interpreting one combined request.
WHATSAPP_TEXT_DEBOUNCE_MS=4000
# Continuous typing cannot keep one batch open indefinitely.
WHATSAPP_TEXT_MAX_WAIT_MS=12000
WHATSAPP_ACCESS_TOKEN=<WHATSAPP_ACCESS_TOKEN>
WHATSAPP_BUSINESS_ACCOUNT_ID=<WHATSAPP_BUSINESS_ACCOUNT_ID>

WHATSAPP_PUBLIC_URL=<WHATSAPP_PUBLIC_URL>

WHATSAPP_PHONE_NUMBER_ID=<WHATSAPP_PHONE_NUMBER_ID>
WHATSAPP_APP_SECRET=<WHATSAPP_APP_SECRET>
# true = log messages instead of sending them
WHATSAPP_DRY_RUN=false
GRAPH_API_VERSION=v21.0
GROQ_API=<YOUR_GROQ_API_KEY>

S3_API=<S3_API>
R2_PUBLIC_URL=<R2_PUBLIC_URL>
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>

AI_VISION_MODEL=<AI_VISION_MODEL>
AI_VISION_BASE_URL=<AI_VISION_BASE_URL>
AI_VISION_API_KEY=<AI_VISION_API_KEY>

# --- Tuning (all optional; the values shown are the defaults) ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
AI_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
AI_WHISPER_MODEL=whisper-large-v3
AI_AUTO_APPLY_MIN=0.85
AI_CLARIFY_MIN=0.6
AI_GUARD_THRESHOLD=0.97
APP_TIMEZONE=Asia/Colombo
AUTO_CLOSURE_SWEEP_MS=30000
AUTO_CLOSURE_DELAY_MINUTES=2
FLOW_CACHE_MS=60000
GUARD_CONFIG_CACHE_MS=60000
# Every language-model call is cut off after this many milliseconds and may ask for at most this many tokens.
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=4000
JOB_REQUEST_WINDOW_HOURS=24

# Local Docker databases (see compose.dev.yaml and docs/developer-guide.md)
DATABASE_URL_TEST=postgresql://fleetlink:fleetlink@localhost:5433/fleetlink_test
SHADOW_DATABASE_URL=postgresql://fleetlink:fleetlink@localhost:5433/fleetlink_shadow

# --- Rate limits (all optional; the values shown are the defaults) ---
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_AI_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_WEBHOOK_PER_MIN=600

# --- Plugins (optional) ---
# Comma-separated plugins to switch on. Default: all five (notifications, driverMatching, delayReasons, autoClosure, jobSummaries)
PLUGINS=notifications,driverMatching,delayReasons,autoClosure,jobSummaries
